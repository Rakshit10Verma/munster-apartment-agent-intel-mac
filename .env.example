# Cloud-only production route. The first configured/healthy provider wins.
AI_PROVIDER_ORDER=anthropic,openai,gemini
AI_TIMEOUT_SECONDS=30
# Optional per-provider overrides. OpenAI must be at least 20 seconds.
ANTHROPIC_TIMEOUT_SECONDS=30
OPENAI_TIMEOUT_SECONDS=30
GEMINI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=1
AI_PROVIDER_COOLDOWN_SECONDS=300

# API keys stay only in .env. Never paste them into source or chat.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

DRY_RUN=true
AUTO_SEND=false
BEWERBERMAPPE_PATH=
APPLICANT_PHOTO_PATH=

# Browser/WG-Gesucht
BROWSER_HEADLESS=false
BROWSER_CHANNEL=chrome
BROWSER_PROFILE_PATH=browser-profile/wg-gesucht
BROWSER_TIMEOUT_SECONDS=30
WG_LOGIN_URL=https://www.wg-gesucht.de/mein-wg-gesucht.html
ENABLE_WG_BROWSER=true
WG_USE_PREMIUM_BOOST=true
# false (default): an unverifiable WG+ priority boost is only a warning; the
# application still sends if every other deterministic gate passes.
# true: an unverifiable boost blocks sending.
WG_PREMIUM_STRICT=false
# Legacy single-search fallback, only used if config.yaml's wg_watch.searches is empty.
WG_SEARCH_URL=https://www.wg-gesucht.de/wg-zimmer-in-Muenster.91.0.1.0.html
# Near-real-time watcher polling interval (randomized jitter between these). Configure
# the actual search URL(s) to watch in config.yaml under wg_watch.searches.
WG_WATCH_MIN_SECONDS=30
WG_WATCH_MAX_SECONDS=45
KLEINANZEIGEN_SEARCH_URL=

# Public portals (low-frequency, at most 25 cards per pass). Disabled by default while
# WG-Gesucht is being made extremely reliable first; set to true to turn back on.
ENABLE_ASTA=false
ASTA_LIST_URL=https://asta.ms/wohnboerse
ENABLE_NA_DANN=false
NA_DANN_LIST_URL=https://www.nadann.de/rubriken/kleinanzeigen/biete-wohnen/

# Gmail saved-search discovery and email delivery (optional)
ENABLE_GMAIL=false
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
GMAIL_ALERT_QUERY=newer_than:2d (from:wg-gesucht.de OR subject:(WG-Gesucht))

# Persistence / daemon
DATABASE_PATH=data/apartment_agent.sqlite
INPUT_DIRECTORY=data/inbox
POLL_INTERVAL_SECONDS=120
LOG_LEVEL=INFO

# Local review dashboard (always binds to 127.0.0.1)
DASHBOARD_PORT=8765
# Optional stable session secret; if empty, a new random secret is used on each start.
DASHBOARD_SECRET_KEY=

# Telegram mobile notifications/controls (optional; the agent behaves normally if
# disabled, and Telegram failures never block discovery/analysis/drafting/sending).
# Run ./telegram_bot.sh once these are set. See README for setup instructions.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id (from @userinfobot). Only this user can act.
TELEGRAM_ALLOWED_USER_ID=
# The chat id notifications/controls use (your private chat with the bot).
TELEGRAM_CHAT_ID=
