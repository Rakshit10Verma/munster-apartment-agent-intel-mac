# Local model first, cloud only when local output is uncertain or fails.
LOCAL_FIRST=true
LOCAL_CONFIDENCE_THRESHOLD=0.84

# Your requested cloud fallback order:
CLOUD_FALLBACK_ORDER=anthropic,openai,gemini

# llama.cpp local server
LLAMA_CPP_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_MODEL_LABEL=gemma-3-4b-it-Q4_K_M

# Optional cloud APIs. Leave blank if unavailable.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

AUTO_SEND=false
