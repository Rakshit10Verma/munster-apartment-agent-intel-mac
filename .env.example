# Cloud-only production route. The first configured/healthy provider wins.
AI_PROVIDER_ORDER=anthropic,openai,gemini
AI_TIMEOUT_SECONDS=25
AI_MAX_RETRIES=1
AI_PROVIDER_COOLDOWN_SECONDS=300

# API keys stay only in .env. Never paste them into source or chat.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

DRY_RUN=true
AUTO_SEND=false
BEWERBERMAPPE_PATH=

# Browser/WG-Gesucht
BROWSER_HEADLESS=false
BROWSER_CHANNEL=chrome
BROWSER_PROFILE_PATH=browser-profile/wg-gesucht
BROWSER_TIMEOUT_SECONDS=30
WG_LOGIN_URL=https://www.wg-gesucht.de/mein-wg-gesucht.html
ENABLE_WG_BROWSER=true
WG_SEARCH_URL=https://www.wg-gesucht.de/wg-zimmer-in-Muenster.91.0.1.0.html
KLEINANZEIGEN_SEARCH_URL=

# Public portals (low-frequency, at most 25 cards per pass)
ENABLE_ASTA=true
ASTA_LIST_URL=https://asta.ms/wohnboerse
ENABLE_NA_DANN=true
NA_DANN_LIST_URL=https://www.nadann.de/rubriken/kleinanzeigen/biete-wohnen/

# Gmail saved-search discovery and email delivery (optional)
ENABLE_GMAIL=false
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
GMAIL_ALERT_QUERY=newer_than:2d (from:wg-gesucht.de OR subject:(WG-Gesucht))

# Persistence / daemon
DATABASE_PATH=data/apartment_agent.sqlite
INPUT_DIRECTORY=data/inbox
POLL_INTERVAL_SECONDS=120
LOG_LEVEL=INFO
